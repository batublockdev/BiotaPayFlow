PAYMENT_MODE=simulation
OPEN_PAYMENTS_ENVIRONMENT=sandbox
# Client wallet address URL that publishes the matching public JWK set.
OPEN_PAYMENTS_CLIENT_WALLET_ADDRESS=
OPEN_PAYMENTS_KEY_ID=./private.key
# Keep the Ed25519 private key in this ignored local file, not in source control.
OPEN_PAYMENTS_PRIVATE_KEY_PATH=./secrets/open-payments-private.pem
OPEN_PAYMENTS_INVESTOR_WALLET_ADDRESS=https://ilp.interledger-test.dev/inversor
OPEN_PAYMENTS_PLATFORM_WALLET_ADDRESS=https://ilp.interledger-test.dev/platform
OPEN_PAYMENTS_BUYER_WALLET_ADDRESS=
OPEN_PAYMENTS_GROWER_WALLET_ADDRESS=https://ilp.interledger-test.dev/grower
OPEN_PAYMENTS_CALLBACK_URL=http://localhost:4000/api/open-payments/callback
OPEN_PAYMENTS_FIXED_RECEIVE_INTERVAL=R/P30D
